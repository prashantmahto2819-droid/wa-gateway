# ===== ज़रूरी / Required =====
# आपका domain (इसका DNS A record VPS के IP पर होना चाहिए), e.g. wa.example.com
DOMAIN=wa.example.com
# Master key — पहली बार /setup पर owner account बनाने और पूरे सिस्टम तक पहुँच के लिए (install.sh अपने-आप बनाता है)
API_KEY=change-me-to-a-long-random-string-48-chars
# आपकी site का पूरा पता (खाली हो तो https://DOMAIN माना जाएगा)
PUBLIC_URL=

# ===== Webhook (आने वाले मैसेज आपकी website पर) =====
WEBHOOK_URL=
WEBHOOK_SECRET=
# फ़ोन से भेजे गए मैसेज भी webhook पर भेजें? (desk के लिए उपयोगी)
WEBHOOK_INCLUDE_SELF=true

# ===== सामान्य / General =====
DEVICE_NAME=Vivid Relay
DEFAULT_COUNTRY_CODE=91
TZ=Asia/Kolkata
LOG_LEVEL=info
WA_LOG_LEVEL=WARN

# ===== सुरक्षित भेजना / Safe sending (anti-ban) =====
# Queue में दो मैसेज के बीच random अंतर
SEND_MIN_DELAY=30s
SEND_MAX_DELAY=60s
# इतने मैसेज के बाद लंबा break
BATCH_SIZE=20
BATCH_PAUSE=10m
# एक नंबर से रोज़ ज़्यादा-से-ज़्यादा मैसेज (direct + queue)
DAILY_LIMIT=250
# उन लोगों को रोज़ कितने मैसेज जिन्होंने कभी हमें मैसेज नहीं किया
NEW_CONTACT_DAILY_LIMIT=40
# नया जुड़ा नंबर पहले दिन इतने से शुरू करेगा, फिर हर दिन 1.6x (0 = बंद)
WARMUP_START=20
# Queue सिर्फ़ इन घंटों में भेजेगी (local time)
SEND_HOUR_FROM=9
SEND_HOUR_TO=21
# Direct API sends के बीच कम-से-कम अंतर
DIRECT_GAP=2s
# भेजने से पहले "typing..." दिखाएँ
TYPING=true
# /check से एक घंटे में कितने नंबर जाँच सकते हैं
CHECK_HOURLY_LIMIT=100
# Error 463 (नए contacts पर रोक) आने पर कितनी देर रुकें
TIMELOCK_PAUSE=6h

# ===== Media =====
MAX_MEDIA_MB=16
ALLOW_PRIVATE_URLS=false

# ===== STOP / START (opt-out) =====
# कोई इनमें से कोई शब्द अकेला लिखे तो उसे campaign मैसेज बंद ("-" लिखें तो सुविधा बंद)
OPTOUT_KEYWORDS=stop,unsubscribe,stop karo,band karo,बंद,बंद करो,रोकें,मत भेजो
OPTIN_KEYWORDS=start,subscribe,शुरू
OPTOUT_REPLY=ठीक है, अब आपको ये संदेश नहीं भेजे जाएँगे। फिर से पाने के लिए START लिखें।
OPTIN_REPLY=धन्यवाद! आपको फिर से संदेश मिलेंगे।

# एक व्यक्ति को 7 दिन में अधिकतम कितने campaign मैसेज (सभी नंबर मिलाकर; 0 = सीमा नहीं)
PER_CONTACT_WEEKLY_LIMIT=3
# इतने दिन में जवाब देने वाले लोगों को queue में सबसे पहले भेजें
RECENT_REPLY_DAYS=30

# ===== नंबर की सेहत (auto slow / pause) =====
# कम से कम इतने campaign मैसेज के बाद ही फ़ैसला
HEALTH_MIN_SAMPLE=30
# इससे ज़्यादा मैसेज fail हों तो queue अपने-आप रुकेगी
HEALTH_MAX_FAIL_RATE=0.25
# नए लोगों में से इससे कम जवाब दें तो भेजना आधी रफ़्तार
HEALTH_MIN_REPLY_RATE=0.03

# एक Status post ज़्यादा से ज़्यादा इतने लोगों तक (10–50000; Admin → सुरक्षित भेजना में भी बदल सकते हैं)
STATUS_MAX_RECIPIENTS=30000

# पुराने queue रिकॉर्ड कितने दिन बाद हटें
RETENTION_DAYS=30

# ===== Auto-reply =====
# फ़ोन से इंसान के जवाब देने के बाद उस chat में bot कितने मिनट चुप रहे (हर नंबर की settings में बदल सकते हैं)
TAKEOVER_MINUTES=30

# ===== Self-hosted licence (सिर्फ़ खरीदारों के server पर; अपने main server पर खाली छोड़ें) =====
# LICENCE_SERVER=https://relay.vividbrandify.com
# LICENCE_KEY=VRS-XXXXX-XXXXX-XXXXX-XXXXX
# LICENCE_PUBLIC_KEY=   (Admin → Licence server से copy करें)
